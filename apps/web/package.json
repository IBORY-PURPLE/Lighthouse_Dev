{
  "name": "@lighthouse/web",
  "private": true,
  "version": "0.0.0",
  "description": "LightHouse 웹 앱. Vercel는 이 폴더를 Root Directory로 둔다.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test:unit",
    "test:e2e": "playwright test --project=e2e",
    "test:e2e:desktop": "playwright test --project=e2e-desktop",
    "test:research-cycle": "playwright test --project=cycle",
    "test:chatbot": "vitest run --config vitest.chatbot.config.mts tests/chatbot/questions.test.ts",
    "test:research-ai": "vitest run --config vitest.chatbot.config.mts tests/chatbot/research-ai.test.ts",
    "test:research-turn": "vitest run --config vitest.chatbot.config.mts tests/chatbot/research-turn.test.ts",
    "test:public": "playwright test --project=public"
  },
  "dependencies": {
    "@animateicons/react": "^0.13.0",
    "@supabase/supabase-js": "2.119.0",
    "groq-sdk": "^1.6.0",
    "next": "^16.4.5",
    "openai": "^7.53.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
