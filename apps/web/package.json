{
  "name": "@lighthouse/web",
  "private": true,
  "version": "0.0.0",
  "description": "LightHouse 웹 앱. Vercel는 이 폴더를 Root Directory로 둔다.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test:unit",
    "test:e2e": "playwright test --project=e2e",
    "test:chatbot": "vitest run --config vitest.chatbot.config.mts",
    "test:public": "playwright test --project=public"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "groq-sdk": "^1.6.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
}
